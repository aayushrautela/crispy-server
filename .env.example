# Environment configuration
NODE_ENV=development

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=18765
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,https://crispy-account-portal.vercel.app

# Admin UI credentials
ADMIN_UI_USER=admin
ADMIN_UI_PASSWORD=change-me
ADMIN_UI_SESSION_SECRET=replace_with_long_random_secret
SECRETS_ENCRYPTION_KEY=base64_encoded_32_byte_key_required
CURSOR_SIGNING_SECRET=replace_with_long_random_secret_at_least_32_chars

# App login (PKCE) configuration
# Format: clientId:allowedReturnUri,clientId:allowedReturnUri,...
APP_LOGIN_ALLOWED_RETURN_URIS=crispy-web:https://app.crispytv.tech/auth/callback,crispy-ios:https://app.crispytv.tech/auth/callback,crispy-ios:com.crispytv.ios://auth/callback,crispy-android:https://app.crispytv.tech/auth/callback,crispy-android:com.crispytv.android://auth/callback,crispy-desktop:com.crispytv.desktop://auth/callback

# Database connection
DATABASE_URL=postgres://crispy:crispy@postgres:5432/crispy
# Maximum Postgres pool connections. Tune based on direct-DB vs PgBouncer mode.
DATABASE_POOL_MAX=20

# Redis connection
REDIS_URL=redis://redis:6379

# Application settings
APP_PUBLIC_URL=https://api.crispytv.tech
APP_DISPLAY_NAME=CrispyTV
ACCOUNT_PORTAL_URL=https://crispy-account-portal.vercel.app
PORTAL_SESSION_SECRET=replace_with_long_random_secret_at_least_32_chars

# Auth provider (Supabase auth-only)
# AUTH_BASE_URL used for JWT verification via JWKS and Auth Admin API calls.
# AUTH_ADMIN_API_KEY used for Auth Admin operations (e.g. user deletion).
AUTH_BASE_URL=https://your-project.supabase.co
AUTH_ADMIN_API_KEY=replace_with_admin_api_key
AUTH_JWT_AUDIENCE=authenticated
# AUTH_JWT_ISSUER overrides the JWT issuer used for verification (defaults to AUTH_BASE_URL/auth/v1).
# Set this to your Supabase project URL (e.g. https://your-project.supabase.co) when the issued
# tokens use a different issuer than AUTH_BASE_URL/auth/v1 (common with self-hosted/Supabase setups).
AUTH_JWT_ISSUER=https://your-project.supabase.co

# External API keys
TMDB_API_KEY=your_tmdb_api_key
MDBLIST_API_KEY=

# AI server-funded credential.
# Server key is used for pro/ultra tier AI features. BYOK users provide their own OpenRouter keys.
AI_SERVER_API_KEY=replace_with_server_funded_ai_key

# Trakt.tv import integration
TRAKT_IMPORT_CLIENT_ID=
TRAKT_IMPORT_CLIENT_SECRET=
TRAKT_IMPORT_REDIRECT_URI=

# SIMKL import integration
SIMKL_IMPORT_CLIENT_ID=
SIMKL_IMPORT_CLIENT_SECRET=
SIMKL_IMPORT_REDIRECT_URI=

# Recommendation engine settings
RECOMMENDATION_ALGORITHM_VERSION=v3.2.1
RECOMMENDATION_GENERATION_TTL_SECONDS=86400
RECOMMENDATION_GENERATION_QUEUE_DELAY_MS=5000

# Official recommender API token (SHA-256 hash of the raw token)
# Generate with: echo -n "your-secret-token" | openssl dgst -sha256 -hex
RECOMMENDER_TO_MAIN_SERVICE_TOKEN_HASH=

# Main-to-recommender internal outbox dispatcher
RECOMMENDER_INTERNAL_BASE_URL=
MAIN_TO_RECOMMENDER_SERVICE_TOKEN=
OUTBOX_DISPATCHER_ENABLED=false
OUTBOX_DISPATCH_BATCH_SIZE=10
OUTBOX_DISPATCH_INTERVAL_MS=5000
OUTBOX_DISPATCH_LOCK_SECONDS=60
OUTBOX_DISPATCH_MAX_ATTEMPTS=10
OUTBOX_DISPATCH_RETRY_BASE_MS=1000
OUTBOX_DISPATCH_RETRY_MAX_MS=300000

# Admin bulk jobs configuration
ADMIN_RECOMMENDATION_RECOMPUTE_JOBS_ENABLED=false
ADMIN_RECOMMENDATION_RECOMPUTE_JOBS_CREATE_ENABLED=false
ADMIN_BULK_JOBS_WORKER_MODE=off
ADMIN_BULK_JOBS_POLL_INTERVAL_MS=5000
ADMIN_BULK_JOBS_POLL_JITTER_MS=1000
ADMIN_BULK_JOBS_CLAIM_TTL_MS=300000
ADMIN_BULK_JOBS_SHUTDOWN_TIMEOUT_MS=30000
ADMIN_BULK_JOBS_MAX_CONCURRENT_JOBS=1
ADMIN_BULK_JOBS_ENUMERATION_PAGE_SIZE=500
ADMIN_BULK_JOBS_FANOUT_BATCH_SIZE=100
